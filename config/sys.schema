{
	"type": "object",
	"additionalProperties": false,
	"required": [
		"ver",
		"styleFontFamily",
		"styleFontSize",
		"styleLineHeight",
		"favorites"
	],
	"properties": {
		"$schema": {
			"type": "string"
		},
		"ver": {
			"type": "string",
			"enum": [
				"0.1"
			]
		},
		"styleFontFamily": {
			"type": "string",
			"minLength": 1
		},
		"styleFontSize": {
			"type": "number",
			"minimum": 1
		},
		"styleLineHeight": {
			"type": "number",
			"minimum": 1
		},
		"favorites": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"name",
					"path"
				],
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1
					},
					"path": {
						"type": "string",
						"minLength": 1
					}
				}
			}
		}
	},
	"patternProperties": {
		"^extension\\..+$": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"win": {
					"$ref": "#/$defs/command"
				},
				"mac": {
					"$ref": "#/$defs/command"
				}
			}
		}
	},
	"$defs": {
		"command": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"command",
				"args"
			],
			"properties": {
				"command": {
					"type": "string",
					"minLength": 1
				},
				"args": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			}
		}
	}
}